# Скопировать в .env.prod и заполнить реальными значениями перед
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-a-long-random-string

# Rate limiting API (P3.4): общий лимит на IP и более строгий лимит логина.
API_RATE_LIMIT=120
API_RATE_WINDOW_MS=60000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
LOGIN_BLOCK_DURATION_MS=300000
PASSWORD_RESET_TTL_MINUTES=30
# Полный публичный URL приложения без завершающего слеша, например https://gym.example.ru
PUBLIC_APP_URL=

# Домен для HTTPS (P0.3) — оставьте пустым, если домена ещё нет: тогда
# приложение работает по IP на обычном порту 80, без замочка в браузере.
# Как только появится домен и его A-запись будет указывать на IP этого
# сервера — впишите домен сюда (например DOMAIN=siberiangym.ru) и
# передеплойте той же командой: Caddy сам получит и продлит сертификат
# Let's Encrypt, ничего больше менять не нужно. См. DEPLOY_GUIDE.md, часть 5.
DOMAIN=

# Первый CEO-аккаунт, создаётся один раз при выполнении seed-скрипта
SEED_CEO_EMAIL=ceo@siberiangym.ru
SEED_CEO_PASSWORD=change-me-to-a-strong-password

# Email-уведомления — необязательно на старте, можно оставить пустым:
# письма будут только логироваться, ничего не сломается.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SiberianGym <no-reply@siberiangym.ru>

# Юридические реквизиты клуба (P0.4, 152-ФЗ) — подставляются в тексты
# согласий на обработку персональных данных, показываемых клиентам. Если
# не заполнить, в текстах согласий будет виден плейсхолдер вместо реальных
# реквизитов — заполнить перед вводом в эксплуатацию, тексты согласий
# должен утвердить юрист клуба (черновики — в prompt-dorabotki-dlya-kluba.md).
GYM_LEGAL_NAME=
GYM_CLUB_NAME=SiberianGym

# Объектное хранилище для фото (P0.5) — до заполнения загрузка фото прямо
# не работает (остальное приложение не ломается). Целевая конфигурация
# сервера предполагает ОТДЕЛЬНОЕ S3-совместимое хранилище (Selectel S3 —
# сформирован специально под эту роль, не MinIO на этом же VPS): создайте
# бакет в консоли провайдера и включите публичный доступ на чтение
# объектов (организационный шаг, как покупка кассы в P0.1 — программная
# часть готова, см. DEPLOY_GUIDE.md), затем впишите значения сюда.
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=siberiangym-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Обычно совпадает с https://<бакет>.<endpoint без схемы> — провайдер
# указывает точный публичный домен бакета в своей консоли.
S3_PUBLIC_URL=

# Резервные копии PostgreSQL (P3.3). Скрипт scripts/backup-postgres.sh
# запускается cron/systemd timer на сервере: создаёт сжатый custom-format dump,
# отправляет его в тот же S3 и задаёт lifecycle-ротацию. Если ключи S3 не
# заполнены, копия сохраняется только локально и старые локальные файлы
# удаляются по BACKUP_RETENTION_DAYS.
BACKUP_RETENTION_DAYS=30
BACKUP_S3_PREFIX=backups/postgres
