# Скопировать в .env.prod и заполнить реальными значениями перед
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-a-long-random-string

# Первый CEO-аккаунт, создаётся один раз при выполнении seed-скрипта
SEED_CEO_EMAIL=ceo@siberiangym.ru
SEED_CEO_PASSWORD=change-me-to-a-strong-password

# Email-уведомления — необязательно на старте, можно оставить пустым:
# письма будут только логироваться, ничего не сломается.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SiberianGym <no-reply@siberiangym.ru>
