DATABASE_URL="postgresql://siberiangym:siberiangym_dev_password@localhost:5433/siberiangym"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN_SECONDS=604800
PORT=3000

# Email-уведомления (SMTP) — если не задать, письма будут только
# логироваться в консоль, ничего не сломается. Подойдёт SMTP любого
# провайдера (Яндекс 360, Mail.ru для бизнеса, Selectel и т.д.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SiberianGym <no-reply@siberiangym.ru>"

# Юридические реквизиты клуба (P0.4, 152-ФЗ) — подставляются в тексты
# согласий на обработку персональных данных. Если не заполнить, в текстах
# согласий будет виден плейсхолдер вместо реальных реквизитов — заполнить
# перед вводом в эксплуатацию, после утверждения текстов юристом клуба.
GYM_LEGAL_NAME=
GYM_CLUB_NAME=SiberianGym

# Объектное хранилище для фото (P0.5) — для локальной разработки уже
# поднят MinIO в docker-compose.yml (`docker compose up -d`), значения
# ниже соответствуют ему как есть. Если S3_ENDPOINT не задан — загрузка
# фото не будет работать, остальное приложение при этом не ломается.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_BUCKET=siberiangym-media
S3_ACCESS_KEY_ID=siberiangym_dev
S3_SECRET_ACCESS_KEY=siberiangym_dev_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/siberiangym-media
