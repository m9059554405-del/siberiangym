// --- Согласия на обработку персональных данных (152-ФЗ, P0.4) ---

enum ConsentType {
  PDN_ADULT // базовое согласие на ПДн, клиент старше 18 (текст №1 в приложении к бэклогу)
  PDN_MINOR_GUARDIAN // согласие законного представителя на ПДн несовершеннолетнего (текст №2) — задел под P0.6
  HEALTH_DATA // данные о физ. показателях и здоровье: замеры, биоимпедансометрия, фото прогресса (текст №3)
  ACTIVITY_WAIVER_ADULT // информированное согласие на занятия физкультурой, 18+ (текст №4)
  ACTIVITY_WAIVER_MINOR_GUARDIAN // то же от законного представителя несовершеннолетнего (текст №5) — задел под P0.6
  MARKETING_MEDIA // фото-/видеосъёмка для маркетинговых материалов (текст №6)
  MARKETING_NEWSLETTER // рекламная и информационная рассылка (текст №7)
  STAFF_PDN // согласие сотрудника (тренера) на обработку его ПДн (текст №10) — задел под P1.4
}

// Факт согласия — журнал добавлений, а не одна перезаписываемая строка:
// каждое действие (дать согласие / отозвать) — новая запись с датой,
// версией текста на тот момент и IP/устройством, откуда оно получено.
// Текущий статус по типу — последняя запись для (clientId, type) по
// createdAt. Не путать с P0.7 (Refund) — это другой журнал, здесь про
// согласие на обработку данных, а не про деньги.
model ConsentRecord {
  id       String @id @default(cuid())
  gymId    String @map("gym_id")
  gym      Gym    @relation(fields: [gymId], references: [id])
  // Ровно один из clientId/trainerId заполнен — subject согласия либо
  // клиент, либо (с P1.4, тип STAFF_PDN) тренер как сотрудник. clientId
  // стал nullable только сейчас (P1.4); у всех существующих записей он
  // и так был заполнен, поэтому ослабление NOT NULL безопасно без бэкфилла.
  clientId  String?     @map("client_id")
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String?     @map("trainer_id")
  trainer   Trainer?    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  type       ConsentType
  version    String // версия текста согласия на момент этой записи, например "2026-09-14"
  granted    Boolean // true — дано этой записью, false — отозвано этой записью
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  // Заполнено только для PDN_MINOR_GUARDIAN/ACTIVITY_WAIVER_MINOR_GUARDIAN
  // (P0.6) — кто именно из законных представителей дал согласие за
  // несовершеннолетнего. Для обычных клиентских согласий (subject сам
  // подтверждает за себя) остаётся null.
  guardianId String?     @map("guardian_id")
  guardian   Guardian?   @relation(fields: [guardianId], references: [id])
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([gymId])
  @@index([clientId, type])
  @@index([trainerId, type])
  @@map("consent_records")
}

// --- Законные представители несовершеннолетних (P0.6) ---

// Законный представитель — отдельная сущность, а не обязательный Client
// (ГК РФ ст. 26, 28; 152-ФЗ). linkedClientId — необязательная связь на
// уже существующего Client, если сам представитель тоже тренируется в
// клубе (не дублируем его контакты второй раз); если нет — Guardian
// существует как лёгкая запись без абонемента и без входа в приложение.
model Guardian {
  id       String  @id @default(cuid())
  gymId    String  @map("gym_id")
  gym      Gym     @relation(fields: [gymId], references: [id])
  fullName String  @map("full_name")
  phone    String
  email    String?
  relation String // человекочитаемое "родитель" / "опекун" и т.п. — справочник на уровне приложения, не enum (по тому же принципу, что GroupClass.type)

  linkedClientId String? @unique @map("linked_client_id")
  linkedClient   Client? @relation(fields: [linkedClientId], references: [id])

  children GuardianChild[]

  createdAt      DateTime        @default(now()) @map("created_at")
  consentRecords ConsentRecord[]

  @@index([gymId])
  @@index([phone])
  @@map("guardians")
}

// Связь многие-ко-многим Guardian↔Client: один представитель может вести
// нескольких детей (братья/сёстры), а по некоторым детям может быть
// несколько представителей (мама и папа) — оба сценария явно требует P0.6.
model GuardianChild {
  id         String   @id @default(cuid())
  guardianId String   @map("guardian_id")
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([guardianId, clientId])
  @@index([clientId])
  @@map("guardian_children")
}

// --- Уведомления (P2.4) ---

// Настройки Web Push (VAPID) — синглтон на инсталляцию. Ключи генерируются
// при первом старте (в .env их нет намеренно: прод-ключи меняются реже
// деплоя, а хранить их в БД проще, чем требовать ручную генерацию).
model AppSetting {
  id        String   @id @default("singleton")
  vapidPublicKey  String @map("vapid_public_key")
  vapidPrivateKey String @map("vapid_private_key")
  vapidSubject    String @default("mailto:no-reply@siberiangym.ru") @map("vapid_subject")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("app_settings")
}

// Подписка браузера клиента на Web Push (P2.4). endpoint — URL push-сервиса
// браузера; при 404/410 от сервиса подписка удаляется отправителем.
model PushSubscription {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("push_subscriptions")
}

// Одно уведомление клиента (журнал и очередь одновременно): planned —
// scheduledFor в будущем и ещё не отправлено (диспетчер подберёт),
// sent — доставлено хотя бы по одному каналу. Уникальность
// (kind, refId, clientId) защищает от дублей напоминаний диспетчером.
enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

model ClientNotification {
  id           String              @id @default(cuid())
  clientId     String              @map("client_id")
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind         String // BOOKING_CREATED | REMINDER_1H | SLOT_CANCELLED ...
  refId        String?             @map("ref_id")
  title        String
  body         String
  channels     NotificationChannel[]
  scheduledFor DateTime            @default(now()) @map("scheduled_for")
  sentAt       DateTime?           @map("sent_at")
  readAt       DateTime?           @map("read_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@unique([kind, refId, clientId])
  @@index([clientId, createdAt])
  @@index([sentAt, scheduledFor])
  @@map("client_notifications")
}

// --- Проходы на входе (P2.2) ---

// Способ, которым администратор зафиксировал проход: камера/USB-сканер
// прочитали QR с экрана клиента — QR; код введён в поле вручную — MANUAL.
enum CheckinSource {
  QR
  MANUAL
}

// Один успешный проход клиента через контроль доступа (P2.2). Дебаунс
// повторного скана живёт в сервисе (окно поверх «последнего прохода
// клиента», без отдельной таблицы); отказы прохода здесь не хранятся —
// журнал отказов не запрашивался, а в activity-log каждый проход тоже
// не пишем (это поток, а не административное действие — иначе журнал
// изменений замусорится сотнями записей в день).
model CheckinEntry {
  id        String        @id @default(cuid())
  gymId     String        @map("gym_id")
  gym       Gym           @relation(fields: [gymId], references: [id])
  clientId  String        @map("client_id")
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  at        DateTime      @default(now())
  source    CheckinSource @default(QR)

  @@index([gymId, at])
  @@index([clientId, at])
  @@map("checkins")
}
