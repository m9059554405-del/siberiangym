// Схема базы данных SiberianGym.
// Перенесена из модели демо-версии (project_gym/src/data/types.ts) в реляционный вид,
// плюс добавлены: Gym (арендатор — сейчас один зал, но структура готова под несколько),
// User (реальная авторизация), Membership/StockBatch и т.д. как отдельные таблицы.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Сеть залов (P1.1) ---
// Отдельный уровень группировки НАД Gym, не путать с мультиарендностью
// gymId (заложена с 0.1.0 под сценарий «продать копию системы другому
// владельцу» — один CEO = один изолированный тенант). Здесь наоборот: один
// CEO управляет несколькими залами-площадками (Gym) в рамках одной сети,
// и данные каждой точки при этом продолжают жить в своих gymId-таблицах —
// P1.2–P1.8 описывают, что именно на уровне сети, а что остаётся на
// уровне точки, по одному аспекту за раз (абонемент, тренер, отчётность,
// физические сущности). `ownerId` намеренно единичный, не список — P1.10
// отдельно фиксирует множественность CEO/совладельцев как нерешённый
// вопрос, не смешивается с этим пунктом.
model Network {
  id String @id @default(cuid())
  // Намеренно БЕЗ @relation на User (нет внешнего ключа на уровне БД) —
  // единственный способ разорвать циклическую зависимость при бутстрапе
  // первой установки: Gym требует существующую Network, Network в обычном
  // варианте требовала бы существующего владельца-User, а User требует
  // существующий Gym. Целостность на уровне приложения обеспечивают все
  // сетевые эндпоинты (resolveOwnedNetworkId и др.), которые всё равно
  // явно проверяют владельца при каждом обращении, а не полагаются на
  // FK. Реального риска осиротевшей ссылки нет — в системе пока не
  // существует способа удалить User целиком (P3.9 — деактивация, не
  // удаление).
  ownerId   String   @unique @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  gyms Gym[]

  @@map("networks")
}

// --- Арендатор (зал/точка) ---
// Один зал сейчас (SiberianGym), но у каждой таблицы ниже есть gymId —
// это значит, что добавить второй зал в будущем = создать новую строку Gym,
// а не переделывать структуру базы. С P1.1 каждый Gym обязательно
// принадлежит ровно одной Network — даже единственный сегодняшний зал.
model Gym {
  id        String   @id @default(cuid())
  networkId String   @map("network_id")
  network   Network  @relation(fields: [networkId], references: [id])
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Возраст, с которого клиент зала может тренироваться самостоятельно, без
  // тренера (P0.6) — «настраиваемое значение на уровне зала/сети», как
  // явно требует задача (некоторые клубы разрешают с 16). До появления
  // сети (P1) это настройка на уровне Gym — единственного уровня
  // группировки, который сейчас есть.
  selfTrainingMinAge Int @default(18) @map("self_training_min_age")

  // Режим управления шкафчиками (P2.8): manual — нынешняя аренда через
  // заказ на кассе (0.4.0), centralized_kiosk — терминал-киоск со сканером
  // QR назначает/возвращает шкафчики сам. Оборудование привязано к точке,
  // не к сети (P1.8); большинство точек остаётся в manual.
  lockerMode       LockerMode @default(manual) @map("locker_mode")

  users              User[]
  clients            Client[]
  trainers           Trainer[]
  exercises          Exercise[]
  groupClasses       GroupClass[]
  groupClassSeries   GroupClassSeries[]
  personalSlots      PersonalSlot[]
  lockers            Locker[]
  catalogItems       CatalogItem[]
  transactions       Transaction[]
  clubPosts          ClubPost[]
  stockBatches       StockBatch[]
  stockWriteoffs     StockWriteoff[]
  stockReceipts      StockReceipt[]
  inventoryCounts    InventoryCount[]
  equipment          Equipment[]
  cleaningChecklists CleaningChecklist[]
  directorMessages   DirectorMessage[]
  reportOffers       ReportOffer[]
  activityLogEntries ActivityLogEntry[]
  outreachNotes      OutreachNote[]
  pricing            MembershipPricing?
  orders             Order[]
  refunds            Refund[]
  consentRecords     ConsentRecord[]
  guardians          Guardian[]
  trainerGyms        TrainerGym[]
  checkins           CheckinEntry[]
  leads              Lead[]
  workingHours       GymWorkingHours[]
  cleaningZones      CleaningZone[]

  @@map("gyms")
}

// Часы работы точки (P4.2) — настраиваются по дням недели владельцем.
// Строка на день: weekday 0=Пн … 6=Вс (та же конвенция, что weekdays серий),
// open/close — "HH:MM". Дня без строки нет в списке = ограничений на этот
// день нет (зал не настроил расписание — обратно совместимо с точками,
// созданными до P4.2, и не ломает существующие тесты).
model GymWorkingHours {
  id      String @id @default(cuid())
  gymId   String @map("gym_id")
  gym     Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  weekday Int
  open    String
  close   String

  @@unique([gymId, weekday])
  @@map("gym_working_hours")
}

// --- Авторизация ---

enum Role {
  CLIENT
  TRAINER
  CEO
  STAFF // "Администратор" в демо-версии — операционная роль (ресепшн/склад/ППР)
}

// Учётная запись для входа. НЕ хранит бизнес-данные клиента/тренера —
// та информация лежит в Client/Trainer и связана через userId (необязательно,
// т.к. администратор может завести карточку клиента до того, как у него
// появится доступ в личный кабинет).
model User {
  id           String   @id @default(cuid())
  gymId        String   @map("gym_id")
  gym          Gym      @relation(fields: [gymId], references: [id])
  email        String?  @unique
  phone        String?  @unique
  // ФИО — заполняется только у STAFF, заведённых через инструмент CEO
  // (P1.10): у CLIENT/TRAINER своё имя уже есть на их собственной карточке
  // (Client.name/Trainer.name), дублировать его здесь не нужно; у CEO
  // (единственная сегодня учётная запись без карточки, заводится
  // seed-скриптом) может оставаться пустым.
  name         String?
  passwordHash             String   @map("password_hash")
  role                     Role
  isActive                 Boolean  @default(true) @map("is_active")
  twoFactorSecret          String?  @map("two_factor_secret")
  twoFactorPendingSecret   String?  @map("two_factor_pending_secret")
  twoFactorEnabled         Boolean  @default(false) @map("two_factor_enabled")
  // P3.8: монотонная версия учёных записей для отзыва JWT. Каждый
  // выданный токен несёт sesVer (версию сессии на момент входа); любое
  // инвалидирование (смена пароля, отключение 2FA, деактивация) поднимает
  // версию — все ранее выданные токены пользователя автоматически
  // перестают проходить проверку в JwtStrategy.
  sessionVersion          Int      @default(0) @map("session_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clientProfile       Client?
  trainerProfile      Trainer?
  passwordResetTokens PasswordResetToken[]

  @@index([gymId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// --- Клиент ---

enum Gender {
  M
  F
}

enum ClientFormat {
  PERSONAL
  GROUP
  SELF
}

enum Tariff {
  BASIC
  COACHING
  INDIVIDUAL
}

model Client {
  id     String  @id @default(cuid())
  gymId  String  @map("gym_id")
  gym    Gym     @relation(fields: [gymId], references: [id])
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  name            String
  gender          Gender
  avatarHue       Int          @default(210) @map("avatar_hue")
  trainerId       String?      @map("trainer_id")
  trainer         Trainer?     @relation(fields: [trainerId], references: [id])
  format          ClientFormat @default(SELF)
  tariff          Tariff?
  joinedAt        DateTime     @map("joined_at")
  birthday        DateTime?    @db.Date
  phone           String?
  email           String?
  profilePhotoUrl String?      @map("profile_photo_url")
  splitPlan       String[]     @map("split_plan")

  membership         Membership?
  formatHistory      ClientFormatHistoryEntry[]
  program            Program?
  workoutLogs        WorkoutLogEntry[]
  progressPhotos     ProgressPhoto[]
  measurements       Measurement[]
  cycleLogs          CycleLog[]
  feedbackMessages   FeedbackMessage[]
  directorMessages   DirectorMessage[]
  outreachNotes      OutreachNote[]
  transactions       Transaction[]
  groupClassBookings GroupClassBooking[]
  personalSlots      PersonalSlot[]
  lockerRentals      Locker[]
  orders             Order[]
  consentRecords     ConsentRecord[]
  guardianLinks      GuardianChild[]
  checkins           CheckinEntry[]
  groupClassWaitlist GroupClassWaitlistEntry[]
  pushSubscriptions  PushSubscription[]
  notifications      ClientNotification[]
  // P2.6: если клиент вырос из лида (гостевой карточки), связь сохраняется
  // после конвертации — история воронки «пришёл узнать → купил».
  convertedFromLeads Lead[]             @relation("LeadConversion")
  // Необязательная обратная связь — если этот клиент сам является чьим-то
  // законным представителем (родитель, тоже тренирующийся в клубе), у него
  // есть привязанная карточка Guardian (P0.6). Guardian.linkedClientId
  // ссылается сюда.
  guardianProfile    Guardian?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([gymId])
  @@index([trainerId])
  @@map("clients")
}

enum MembershipType {
  SINGLE
  MONTHLY
  PACK10
  PACK20
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  FROZEN
}

// Абонемент либо действует только на той точке сети, где куплен, либо на
// всей сети (P1.2) — цена за NETWORK обычно выше, настраивается отдельно
// в MembershipPricing и не обязана существовать на каждой точке (точка
// может вообще не продавать сетевой вариант). Реальная физическая
// проверка "пустили клиента в конкретную дверь или нет" — это P1.5/P2.2
// (турникет/чек-ин), которых ещё нет; здесь только тарифная модель и
// то, что фактически куплено.
enum MembershipScope {
  SINGLE_GYM
  NETWORK
}

// Текущий абонемент клиента — всегда один актуальный ряд на клиента
// (история смен абонемента не нужна отдельной таблицей: каждая покупка
// просто перезаписывает эти поля, как и в демо-версии). Поля заморозки
// (P2.1): freezeEndsAt — первый день, когда абонемент снова действует
// (статус FROZEN в БД «оттаивает» лениво на чтении, планировщика нет);
// frozenDaysUsed — сколько дней заморозки израсходовано в текущем
// оплаченном периоде, сбрасывается при новой покупке/продлении.
model Membership {
  id             String           @id @default(cuid())
  clientId       String           @unique @map("client_id")
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           MembershipType
  scope          MembershipScope  @default(SINGLE_GYM)
  purchasedAt    DateTime         @map("purchased_at")
  expiresAt      DateTime?        @map("expires_at") @db.Date
  visitsTotal    Int?             @map("visits_total")
  visitsLeft     Int?             @map("visits_left")
  status         MembershipStatus @default(ACTIVE)
  frozenDaysUsed Int              @default(0) @map("frozen_days_used")
  freezeEndsAt   DateTime?        @map("freeze_ends_at") @db.Date

  @@map("memberships")
}

// Воронка «пришёл узнать → попробовал → купил» (P2.6). Минимум по
// бэклогу: гостевая карточка с датой визита и статусом конверсии.
// Лид — отдельная сущность: клиент в системе появляется только когда
// гость покупает абонемент (обычная регистрация клиента с чеком),
// конвертация лишь фиксирует связь с созданным клиентом. Гостевого
// прохода через контроль доступа (P2.2) для лида нет: пробное посещение
// отмечается статусом VISITED вручную персоналом.
enum LeadStatus {
  NEW
  VISITED
  CONVERTED
  LOST
}

model Lead {
  id                String     @id @default(cuid())
  gymId             String     @map("gym_id")
  gym               Gym        @relation(fields: [gymId], references: [id])
  name              String
  phone             String?
  email             String?
  visitDate         DateTime?  @map("visit_date") @db.Date
  status            LeadStatus @default(NEW)
  note              String?
  convertedClientId String?    @map("converted_client_id")
  convertedClient   Client?    @relation("LeadConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?  @map("converted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([gymId])
  @@map("leads")
}

// История смены тренера/формата — нужна тренеру и в профиле клиента,
// чтобы видеть "кто у кого тренировался и когда".
model ClientFormatHistoryEntry {
  id        String       @id @default(cuid())
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String?      @map("trainer_id")
  format    ClientFormat
  from      DateTime     @db.Date
  to        DateTime?    @db.Date
  reason    String?

  @@index([clientId])
  @@map("client_format_history")
}

// --- Тренер ---

// Статус занятости тренера (P1.4) — важно для 54-ФЗ (расчёты с
// самозанятыми оформляются иначе, чем зарплата штатному сотруднику) и
// для будущего расчёта выплат. Nullable на уровне Trainer — у уже
// существующих (реальных прод-) тренеров этот вопрос никто не задавал,
// выдумывать им значение задним числом неверно; обязательно только для
// НОВЫХ тренеров, заводимых через форму.
enum EmploymentType {
  EMPLOYEE // штатный сотрудник
  SELF_EMPLOYED // самозанятый
  SOLE_PROPRIETOR // ИП
}

model Trainer {
  id     String  @id @default(cuid())
  gymId  String  @map("gym_id")
  gym    Gym     @relation(fields: [gymId], references: [id])
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  name                 String
  avatarHue            Int     @default(210) @map("avatar_hue")
  specialization       String
  bio                  String?
  fullBio              String? @map("full_bio")
  experienceYears      Int     @default(0) @map("experience_years")
  personalSessionPrice Int     @map("personal_session_price")
  externalUrl          String? @map("external_url")
  // P1.4 — оба nullable по той же причине, что и employmentType: не
  // придумываем задним числом значения существующим тренерам.
  employmentType       EmploymentType? @map("employment_type")
  revenueSharePercent  Int?            @map("revenue_share_percent")

  // Временное отсутствие (отпуск/болезнь, P2.10) — календарный диапазон
  // включительно: в эти дни тренеру нельзя назначать новые персональные
  // слоты и групповые занятия, а его будущие слоты разбираются массово
  // (перенос другому тренеру или отмена с уведомлением клиентов).
  // Оба поля всегда либо заполнены вместе, либо оба пустые (работает как
  // обычно) — целостность держит сервис, а не БД, чтобы не плодить
  // частично заполненные диапазоны из старых клиентов Prisma.
  unavailableFrom DateTime? @map("unavailable_from") @db.Date
  unavailableUntil DateTime? @map("unavailable_until") @db.Date
  // Окончательно ушедший (P2.10): момент, когда CEO зафиксировал уход.
  // Это не то же самое, что недоступность — уход необратим в рамках
  // операционки (возврат = отдельное явное решение через ACTIVE), а логин
  // тренера деактивируется (User.isActive=false), см. P3.8/P3.9 про то,
  // почему деактивация, а не удаление.
  departedAt DateTime? @map("departed_at")

  clients           Client[]
  workHours         TrainerWorkHour[]
  credentials       TrainerCredential[]
  competitionPhotos TrainerCompetitionPhoto[]
  groupClasses      GroupClass[]
  groupClassSeries  GroupClassSeries[]
  personalSlots     PersonalSlot[]
  transactions      Transaction[]
  consentRecords    ConsentRecord[]
  // Дополнительные точки сети, где тренер тоже ведёт занятия (P1.3) —
  // `gymId` выше остаётся "домашней" точкой (где заведена карточка и
  // логин), эта связь — только для точек СВЕРХ неё. Тренер без единой
  // записи здесь всё равно работает как раньше (только на своей точке).
  additionalGyms TrainerGym[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([gymId])
  @@map("trainers")
}

// Многие-ко-многим Trainer<->Gym сверх домашней точки (P1.3) — CEO
// назначает тренера на дополнительные залы своей сети, персональные
// слоты/групповые занятия на этих точках создаются на общих основаниях.
model TrainerGym {
  id        String  @id @default(cuid())
  trainerId String  @map("trainer_id")
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  gymId     String  @map("gym_id")
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([trainerId, gymId])
  @@index([gymId])
  @@map("trainer_gyms")
}

model TrainerWorkHour {
  id        String  @id @default(cuid())
  trainerId String  @map("trainer_id")
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  day       Int // 0=понедельник ... 6=воскресенье
  startHour Int     @map("start_hour")
  endHour   Int     @map("end_hour")

  @@map("trainer_work_hours")
}

model TrainerCredential {
  id        String  @id @default(cuid())
  trainerId String  @map("trainer_id")
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title      String
  issuedBy   String?  @map("issued_by")
  year       Int?
  expiresAt  DateTime? @map("expires_at") @db.Date
  isRequired Boolean  @default(false) @map("is_required")

  @@map("trainer_credentials")
}

model TrainerCompetitionPhoto {
  id        String  @id @default(cuid())
  trainerId String  @map("trainer_id")
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  url       String
  caption   String?

  @@map("trainer_competition_photos")
}

// --- Упражнения и программы тренировок ---

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  ABS
  CARDIO
}

model Exercise {
  id               String      @id @default(cuid())
  gymId            String      @map("gym_id")
  gym              Gym         @relation(fields: [gymId], references: [id])
  name             String
  muscleGroup      MuscleGroup @map("muscle_group")
  defaultSets      Int         @map("default_sets")
  defaultReps      String      @map("default_reps")
  defaultLoad      String      @map("default_load")
  technique        String?
  equipment        String?
  imageUrl         String?     @map("image_url")
  imageAttribution String?     @map("image_attribution")

  @@index([gymId])
  @@map("exercises")
}

// У клиента ровно одна актуальная программа тренировок — при каждом
// обновлении дни/упражнения полностью пересоздаются (как updateOwnProgram
// / updateClientProgram в демо-версии, где программа — это одна запись,
// которая целиком перезаписывается).
model Program {
  id         String   @id @default(cuid())
  clientId   String   @unique @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedBy String   @map("assigned_by") // 'trainer' | 'self'
  updatedAt  DateTime @updatedAt @map("updated_at")

  days ProgramDay[]

  @@map("programs")
}

model ProgramDay {
  id        String  @id @default(cuid())
  programId String  @map("program_id")
