// --- Клининг ---

// Зона уборки точки (P4.2) — раньше был глобальный enum из 7 значений,
// перенесённый как константа из демо-версии: зал не мог ни переименовать,
// ни добавить/убрать зону. Теперь список зон настраивается владельцем под
// конкретный зал; чек-листы при создании получают текущий набор зон.
model CleaningZone {
  id       String @id @default(cuid())
  gymId    String @map("gym_id")
  gym      Gym    @relation(fields: [gymId], references: [id])
  name     String
  position Int    @default(0)

  items CleaningChecklistItem[]

  @@unique([gymId, name])
  @@map("cleaning_zones")
}

model CleaningChecklist {
  id              String   @id @default(cuid())
  gymId           String   @map("gym_id")
  gym             Gym      @relation(fields: [gymId], references: [id])
  date            DateTime @db.Date
  responsibleName String   @map("responsible_name")

  items CleaningChecklistItem[]

  @@index([gymId])
  @@map("cleaning_checklists")
}

model CleaningChecklistItem {
  id          String            @id @default(cuid())
  checklistId String            @map("checklist_id")
  checklist   CleaningChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  // Зона ссылки без Cascade: удалить зону, на которую ссылается история
  // чек-листов, нельзя (FK Restrict) — сервис проверяет это заранее и
  // отвечает 409 с понятным текстом.
  zoneId      String            @map("zone_id")
  zone        CleaningZone      @relation(fields: [zoneId], references: [id])
  done        Boolean           @default(false)

  @@unique([checklistId, zoneId])
  @@map("cleaning_checklist_items")
}

