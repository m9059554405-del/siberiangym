// --- Групповые занятия и персональные слоты ---

model GroupClass {
  id        String   @id @default(cuid())
  gymId     String   @map("gym_id")
  gym       Gym      @relation(fields: [gymId], references: [id])
  type      String // напр. "Кроссфит-микс" — справочник ведётся на уровне приложения, не enum
  trainerId String   @map("trainer_id")
  trainer   Trainer  @relation(fields: [trainerId], references: [id])
  zone      String
  date      DateTime @db.Date
  start     String // "HH:MM"
  end       String
  capacity  Int

  // P2.12: занятие-occurrence, сгенерированное серией GroupClassSeries;
  // null — занятие создано вручную на конкретную дату (как раньше).
  // Identity occurrence = (seriesId, date): при генерации дата с уже
  // существующим занятием серии пропускается, поэтому occurrence с
  // записями клиентов после редактирования серии не дублируется новым
  // временем — он «материализован» (клиент купил именно это занятие).
  seriesId String?           @map("series_id")
  series   GroupClassSeries? @relation(fields: [seriesId], references: [id])

  bookings GroupClassBooking[]
  waitlist GroupClassWaitlistEntry[]

  @@index([gymId])
  @@index([trainerId])
  // P3.14: горячий запрос «расписание точки на день/диапазон» фильтрует
  // сразу по gymId и дате — составной индекс вместо пересечения двух
  // одиночных.
  @@index([gymId, date])
  @@index([seriesId, date])
  @@map("group_classes")
}

// Шаблон еженедельного расписания (P2.12): CEO/STAFF задаёт правило
// («Йога, Пн и Чт 19:00–20:00, зал 2»), а конкретные занятия-occurrence
// (GroupClass с seriesId) генерируются автоматически на настраиваемый
// горизонт вперёд — при создании серии, при каждом тике диспетчера
// (скользящее окно) и по запросу /regenerate. Дни недели нумеруются как
// TrainerWorkHour.day (0=Пн ... 6=Вс). Отмена серии мягкая (cancelledAt):
// шаблон перестаёт генерировать, будущие occurrence без записей удаляются,
// с записями — отменяются с уведомлением клиентов (записи не переносятся
// автоматически: возврат денег — отдельный ручной процесс P0.7).
model GroupClassSeries {
  id        String  @id @default(cuid())
  gymId     String  @map("gym_id")
  gym       Gym     @relation(fields: [gymId], references: [id])
  type      String
  trainerId String  @map("trainer_id")
  trainer   Trainer @relation(fields: [trainerId], references: [id])
  zone      String
  start     String // "HH:MM"
  end       String
  capacity  Int
  weekdays  Int[] // 0=Пн ... 6=Вс — как TrainerWorkHour.day
  // Серия действует с startDate по endDate включительно; endDate null —
  // бессрочно (пока не отменят). Оба поля — календарные дни UTC-полночь.
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  // Глубина скользящего горизонта генерации от сегодняшнего дня.
  horizonDays Int       @default(28) @map("horizon_days")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  occurrences GroupClass[]

  @@index([gymId])
  @@index([trainerId])
  @@map("group_class_series")
}

model GroupClassBooking {
  id           String     @id @default(cuid())
  groupClassId String     @map("group_class_id")
  groupClass   GroupClass @relation(fields: [groupClassId], references: [id], onDelete: Cascade)
  clientId     String     @map("client_id")
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookedAt     DateTime   @default(now()) @map("booked_at")

  @@unique([groupClassId, clientId])
  @@map("group_class_bookings")
}

// Лист ожидания на групповое занятие (P2.3): заполняется, когда места
// закончились. При освобождении места (отмена записи клиентом или
// возврат по заказу) первый ещё не уведомлённый ждущий получает email
// (notifiedAt); место при этом НЕ резервируется — запись на занятие
// остаётся обычной покупкой через заказ с чеком (P0.2), уведомление
// только сообщает, что очередь подошла.
model GroupClassWaitlistEntry {
  id           String     @id @default(cuid())
  groupClassId String     @map("group_class_id")
  groupClass   GroupClass @relation(fields: [groupClassId], references: [id], onDelete: Cascade)
  clientId     String     @map("client_id")
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now()) @map("joined_at")
  notifiedAt   DateTime?  @map("notified_at")

  @@unique([groupClassId, clientId])
  @@index([groupClassId, joinedAt])
  @@map("group_class_waitlist")
}

enum SlotStatus {
  FREE
  BOOKED
  PAST_COMPLETED
  PAST_MISSED
}

model PersonalSlot {
  id        String     @id @default(cuid())
  gymId     String     @map("gym_id")
  gym       Gym        @relation(fields: [gymId], references: [id])
  trainerId String     @map("trainer_id")
  trainer   Trainer    @relation(fields: [trainerId], references: [id])
  date      DateTime   @db.Date
  start     String
  end       String
  clientId  String?    @map("client_id")
  client    Client?    @relation(fields: [clientId], references: [id])
  status    SlotStatus @default(FREE)

  @@index([gymId])
  @@index([trainerId])
  // P3.14: тот же горячий сценарий, что у групповых занятий.
  @@index([gymId, date])
  @@map("personal_slots")
}

// --- Шкафчики ---

enum LockerStatus {
  FREE
  RENTED
}

// P2.8: centralized_kiosk — на точке смонтирован терминал-киоск и
// электронные замки с датчиком двери; manual — ручная аренда на кассе.
enum LockerMode {
  manual
  centralized_kiosk
}

// Состояние дверцы по датчику замка (P2.8): обновляется колбэком от
// контроллера; null — датчика нет/состояние неизвестно.
enum LockerDoorState {
  OPEN
  CLOSED
}

model Locker {
  id          String           @id @default(cuid())
  gymId       String           @map("gym_id")
  gym         Gym              @relation(fields: [gymId], references: [id])
  number      Int
  status      LockerStatus     @default(FREE)
  rentedBy    String?          @map("rented_by")
  client      Client?          @relation(fields: [rentedBy], references: [id])
  rentedUntil DateTime?        @map("rented_until") @db.Date
  pricePerDay Int              @map("price_per_day")
  // Оборудование киоска (P2.8): банк (ряд) шкафчиков, сетевой контроллер
  // ряда и номер релейного выхода на дверцу. Заполнены только на точках
  // с централизованным управлением; null — обычный шкафчик под ручную
  // аренду. assignedAt — момент назначения через киоск (rentedBy — кто).
  bankId         String?          @map("bank_id")
  controllerId   String?          @map("controller_id")
  channelNumber  Int?             @map("channel_number")
  doorState      LockerDoorState? @map("door_state")
  assignedAt     DateTime?        @map("assigned_at")

  @@index([gymId])
  @@map("lockers")
}

// --- Магазин / каталог и продажи клиентам ---

enum CatalogCategory {
  FOOD
  WATER
}

model CatalogItem {
  id       String          @id @default(cuid())
  gymId    String          @map("gym_id")
  gym      Gym             @relation(fields: [gymId], references: [id])
  name     String
  category CatalogCategory
  price    Int
  emoji    String

  stockBatches   StockBatch[]
  stockWriteoffs StockWriteoff[]
  stockReceipts  StockReceipt[]

  @@index([gymId])
  @@map("catalog_items")
}

// --- Заказы и подтверждение оплаты чеком (P0.2, 54-ФЗ) ---
//
// Раньше денежные действия (продление абонемента, смена тарифа, покупка
// товара, аренда шкафчика, запись на занятие) сразу создавали Transaction —
// система верила администратору на слово, что деньги реально приняты.
// Order — промежуточная сущность: деньги считаются принятыми и все связанные
// действия (продление абонемента, бронирование слота и т.д.) применяются
// ТОЛЬКО после того, как реальный кассовый чек отсканирован и его сумма
// сверена с суммой заказа. Ничего не применяется заранее — это осознанно
// выбранная более безопасная из двух стратегий, описанных в P0.2.
enum OrderStatus {
  DRAFT // собирается (позиции добавлены, оплата ещё не запрошена)
  AWAITING_PAYMENT // администратор нажал "оплата наличными", ждём скан чека
  PAID // чек отсканирован и сумма совпала — все позиции применены
  CANCELLED // отменено вручную (клиент передумал, администратор ошибся)
  EXPIRED // истёк таймаут ожидания оплаты — никто не подтвердил чек
}

enum OrderPaymentMethod {
  CASH // наличные/карта на физическом терминале администратора — оба подтверждаются одинаково, сканом чека
  CARD_ONLINE // самостоятельная оплата картой в приложении — появится с P2.9, пока не используется
}

// Тип позиции заказа. Один заказ может содержать несколько позиций разных
// типов (пример из ТЗ: продление абонемента + покупка воды одним чеком).
enum OrderLineType {
  MEMBERSHIP_PURCHASE
  MEMBERSHIP_RENEWAL
  TARIFF_CHANGE
  STOCK_PURCHASE
  LOCKER_RENTAL
  GROUP_CLASS_BOOKING
  PERSONAL_SLOT_BOOKING
}

model Order {
  id        String @id @default(cuid())
  gymId     String @map("gym_id")
  gym       Gym    @relation(fields: [gymId], references: [id])
  clientId  String @map("client_id")
  client    Client @relation(fields: [clientId], references: [id])
  createdBy String @map("created_by") // userId того, кто собрал заказ — видимость и право закрыть не привязаны к нему намертво (P0.2)

  status        OrderStatus         @default(DRAFT)
  paymentMethod OrderPaymentMethod? @map("payment_method")
  totalAmount   Int                 @map("total_amount") // сумма всех строк на момент СОЗДАНИЯ заказа — ценовой снэпшот, не пересчитывается при оплате

  // Сырые и разобранные данные фискального чека (формат ФНС:
  // t=<дата-время>&s=<сумма>&fn=<номер ФН>&i=<номер документа>&fp=<фискальный признак>&n=<тип операции>).
  // Уникальность fn+i+fp — единственная защита от повторного использования одного чека на два заказа.
  receiptRaw  String?   @map("receipt_raw")
  receiptDate DateTime? @map("receipt_date")
  receiptFn   String?   @map("receipt_fn")
  receiptI    String?   @map("receipt_i")
  receiptFp   String?   @map("receipt_fp")

  expiresAt    DateTime? @map("expires_at") // после этого момента "брошенный" AWAITING_PAYMENT заказ автоматически становится EXPIRED
  paidAt       DateTime? @map("paid_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines        OrderLine[]
  transactions Transaction[]
  refunds      Refund[]

  // NULL != NULL в Postgres — несколько ещё не оплаченных заказов с пустыми
  // реквизитами чека спокойно сосуществуют, ограничение реально срабатывает
  // только когда все три поля заполнены реальным чеком.
  @@unique([receiptFn, receiptI, receiptFp])
  @@index([gymId])
  @@index([clientId])
  @@index([status])
  @@map("orders")
}

model OrderLine {
  id      String        @id @default(cuid())
  orderId String        @map("order_id")
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    OrderLineType
  refId   String?       @map("ref_id") // id связанной сущности (тренер/товар/шкафчик/занятие/слот), смысл зависит от type
  amount  Int // цена этой позиции на момент СОЗДАНИЯ заказа
  meta    Json? // доп. данные, нужные для применения позиции при оплате (membershipType, tariff, дни аренды и т.п.)

  @@map("order_lines")
}

// --- Возврат оплаты (P0.7) ---
//
// По 54-ФЗ отмена платежа — не "удалить транзакцию из базы", а отдельный
// фискальный документ "чек возврата прихода": администратор пробивает его
// на кассе так же, как обычный чек в P0.2, и сканирует в систему. Пока
// чек возврата не подтверждён — заказ остаётся оплаченным, откат не
// применяется (та же стратегия "ничего не применяется без чека", что в P0.2).
enum RefundStatus {
  AWAITING_RECEIPT // возврат запрошен, ждём скан чека возврата прихода
  CONFIRMED // чек возврата отсканирован, сумма совпала — откат применён
  CANCELLED // запрос на возврат отменён до скана (передумали)
}

// В этой версии поддерживается только полный возврат заказа целиком —
// осознанное решение вместо частичного возврата по отдельным OrderLine,
// чтобы не плодить неявные промежуточные состояния (явно предложено как
// более простая альтернатива в самой задаче P0.7).
model Refund {
  id          String       @id @default(cuid())
  gymId       String       @map("gym_id")
  gym         Gym          @relation(fields: [gymId], references: [id])
  orderId     String       @map("order_id")
  order       Order        @relation(fields: [orderId], references: [id])
  requestedBy String       @map("requested_by") // userId того, кто оформил возврат
  reason      String
  amount      Int // = Order.totalAmount на момент запроса возврата
  status      RefundStatus @default(AWAITING_RECEIPT)

  receiptRaw  String?   @map("receipt_raw")
  receiptDate DateTime? @map("receipt_date")
  receiptFn   String?   @map("receipt_fn")
  receiptI    String?   @map("receipt_i")
  receiptFp   String?   @map("receipt_fp")

  confirmedAt DateTime? @map("confirmed_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lines RefundLine[]

  // Та же защита, что у Order: один чек возврата нельзя привязать к двум
  // возвратам (NULL != NULL в Postgres — не мешает нескольким ещё не
  // подтверждённым возвратам сосуществовать).
  @@unique([receiptFn, receiptI, receiptFp])
  @@index([gymId])
  @@index([orderId])
  @@map("refunds")
}

// Что реально произошло с каждой позицией исходного заказа при откате —
// для аудита (CEO должен видеть не просто "деньги вернули", а что именно
// откатилось: абонемент, бронь, шкафчик — или физически откатывать было
// нечего, как в случае с товаром, см. P0.7 в CHANGELOG).
model RefundLine {
  id          String @id @default(cuid())
  refundId    String @map("refund_id")
  refund      Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderLineId String @map("order_line_id")
  detail      String

  @@map("refund_lines")
}

// --- Финансы ---

enum TransactionCategory {
  MEMBERSHIP
  PERSONAL
  GROUP
  ANCILLARY
  REFUND // отрицательная сумма — возврат по P0.7, отдельная категория, а не "тихая" отрицательная транзакция без объяснения причины
}

model Transaction {
  id          String              @id @default(cuid())
  gymId       String              @map("gym_id")
  gym         Gym                 @relation(fields: [gymId], references: [id])
  date        DateTime            @default(now())
  amount      Int
  category    TransactionCategory
  clientId    String              @map("client_id")
  client      Client              @relation(fields: [clientId], references: [id])
  trainerId   String?             @map("trainer_id")
  trainer     Trainer?            @relation(fields: [trainerId], references: [id])
  description String
  orderId     String?             @map("order_id") // источник — заказ, подтверждённый чеком (P0.2); null для старых записей, созданных до этой версии
  order       Order?              @relation(fields: [orderId], references: [id])

  @@index([gymId])
  @@index([clientId])
  @@map("transactions")
}

// Цены на абонементы и разовые услуги — раньше было захардкожено в
// демо-версии, теперь настраивается на уровне зала.
model MembershipPricing {
  id             String @id @default(cuid())
  gymId          String @unique @map("gym_id")
  gym            Gym    @relation(fields: [gymId], references: [id])
  single         Int
  monthly        Int
  pack10         Int
  pack20         Int
  // Сетевые варианты (P1.2) — действуют на всех точках сети, а не только
  // здесь, поэтому обычно дороже. Nullable: точка не обязана продавать
  // сетевой вариант вообще (null — только вариант "эта точка").
  singleNetwork  Int?   @map("single_network")
  monthlyNetwork Int?   @map("monthly_network")
  pack10Network  Int?   @map("pack10_network")
  pack20Network  Int?   @map("pack20_network")
  personalSingle Int    @map("personal_single")
  personalPack5  Int    @map("personal_pack5")
  groupSingle    Int    @map("group_single")
  groupMonthly   Int    @map("group_monthly")
  // Тарифы сопровождения тренера (P4.2) — раньше цены были константой в
  // коде (2500/4900/15900 из демо-версии) и не настраивались точкой.
  // Дефолты совпадают со старой константой, миграция ничего не меняет.
  escortBasic      Int @default(2500)  @map("escort_basic")
  escortCoaching   Int @default(4900)  @map("escort_coaching")
  escortIndividual Int @default(15900) @map("escort_individual")

  @@map("membership_pricing")
}

// --- Новости клуба ---

enum ClubPostType {
  NEWS
  PHOTO
  VIDEO
  ACHIEVEMENT
}

model ClubPost {
  id         String       @id @default(cuid())
  gymId      String       @map("gym_id")
  gym        Gym          @relation(fields: [gymId], references: [id])
  date       DateTime     @default(now())
  authorName String       @map("author_name")
  authorRole String       @map("author_role")
  type       ClubPostType
  title      String
  text       String
  likes      Int          @default(0)

  media ClubPostMedia[]

  @@index([gymId])
  @@map("club_posts")
}

model ClubPostMedia {
  id      String   @id @default(cuid())
  postId  String   @map("post_id")
  post    ClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind    String // 'photo' | 'video'
  url     String
  caption String?

  @@map("club_post_media")
}

// --- Обратная связь клиент ↔ тренер ---

model FeedbackMessage {
  id       String   @id @default(cuid())
  clientId String   @map("client_id")
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  from     String // 'client' | 'trainer'
